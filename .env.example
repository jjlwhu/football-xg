# 复制：cp .env.example .env
# 自己发给自己：ALERT_TO 和 SMTP_USER 填同一个 Gmail

ALERT_TO=你的账号@gmail.com
SMTP_USER=你的账号@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# 下面填 16 位「应用专用密码」，不是登录密码。空格可留可删。
SMTP_PASS=xxxx xxxx xxxx xxxx

# InferSports 免费 key：https://infersports.dev/signup
INFERSPORTS_API_KEY=

# 作息写死在程序里：欧洲 8:30 通扫当天；0:00 扫未来9小时；
# 9:00–23:00 与 1:00 整点扫未来1.5小时；其余休息。
